# These are NOT read from a .env file automatically — Supabase Edge Functions
# get their secrets from `supabase secrets set`, run from the CLI (see README).
# This file just documents what needs setting, and where.

# --- Supabase Edge Function secrets (set via `supabase secrets set`) ---
STRIPE_SECRET_KEY=sk_test_...        # swap for sk_live_... at launch
STRIPE_WEBHOOK_SECRET=whsec_...      # from Stripe Dashboard > Webhooks, after you add the endpoint
RESEND_API_KEY=re_...                # from resend.com, used to email you on new orders
ORDER_NOTIFY_EMAIL=dodgedesignedthis@gmail.com   # where new-order emails go
SITE_URL=https://dodgedesignedthis.co.uk   # no trailing slash

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase for Edge Functions — you don't set these yourself.
